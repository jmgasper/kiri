name kiri
version 0.1.0~beta3-1
architecture x86_64
summary "A native project editor with Git and an embedded terminal"
description "Kiri is a native C++ workspace for source files, images and large projects. It includes editor font preferences, ten themes, syntax highlighting, a file explorer with native icons, Git history and diffs, commits, GitHub line permalinks, project search and tabbed PTY terminals."
packager "Kiri contributors"
vendor "Kiri"
copyrights { "2026 Kiri contributors" "2008 Paul Evans <leonerd@leonerd.org.uk>" }
licenses { "MIT" }
provides {
    kiri = 0.1.0~beta3
    app:Kiri = 0.1.0~beta3
}
requires {
    haiku >= r1~beta5
    lib:libscintilla >= 5.3.4
    lib:liblexilla >= 5.4.6
    cmd:git
}
